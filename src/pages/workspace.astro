---
import '../workspace/workspace.css';
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>个人工作区 · LiShihhsing</title></head><body>
<aside><strong>LiShihhsing</strong><nav aria-label="工作区导航"><button data-view="today">今天</button><button data-view="projects">项目</button><button data-view="calendar">日历</button><button data-view="notes">笔记</button><button data-view="ledger">账本</button><button data-view="focus">专注</button></nav><div class="utilities"><button id="theme-toggle" data-action="theme" aria-pressed="false">夜间模式</button><button data-action="settings">账号与备份</button><button data-action="trash">回收站</button><a href="/">← 个人主页</a></div></aside>
<main><header class="row"><h1 id="heading">正在打开工作区…</h1><span id="save-status" role="status">正在读取</span></header><div id="cloud-banner"></div><div id="content"></div></main>
<dialog id="dialog"><form id="form"><div class="row"><h2 id="dialog-title"></h2><button type="button" data-action="close">关闭</button></div><div id="fields"></div><p id="form-error" role="alert"></p><footer class="actions"><button id="submit" class="primary" type="submit">保存</button><button type="button" data-action="close">取消</button></footer></form></dialog>
<div id="toast" role="status"></div><input id="backup-file" type="file" accept="application/json,.json" hidden/><input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden/>
<script>import '../workspace/app.js';</script>
</body></html>
