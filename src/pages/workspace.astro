---
import '../workspace/workspace.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>个人工作区 · LiShihhsing</title>
  </head>
  <body>
    <section id="auth-root" class="auth-gate" aria-labelledby="auth-title">
      <div class="auth-card">
        <a class="auth-home" href="/">LiShihhsing</a>
        <div class="auth-icon" aria-hidden="true">锁</div>
        <p class="auth-kicker">私人工作区</p>
        <h1 id="auth-title">登录后继续</h1>
        <div class="auth-segment" role="tablist" aria-label="账号操作">
          <button type="button" class="active" data-auth-mode="login" role="tab" aria-selected="true">登录</button>
          <button type="button" data-auth-mode="signup" role="tab" aria-selected="false">注册</button>
        </div>
        <form id="auth-form">
          <label id="auth-email-field">邮箱<input name="email" type="email" autocomplete="email" required /></label>
          <label>密码<input name="password" type="password" autocomplete="current-password" minlength="8" required /></label>
          <button id="auth-submit" class="primary auth-submit" type="submit">登录工作区</button>
        </form>
        <button id="forgot-password" class="auth-link" type="button">忘记密码</button>
        <p id="auth-status" class="auth-status" role="status"></p>
      </div>
    </section>

    <aside data-workspace hidden>
      <strong>LiShihhsing</strong>
      <nav aria-label="工作区导航"><button data-view="today">今天</button><button data-view="projects">项目</button><button data-view="calendar">日历</button><button data-view="notes">笔记</button><button data-view="ledger">账本</button><button data-view="focus">专注</button></nav>
      <div class="utilities"><button id="theme-toggle" data-action="theme" aria-pressed="false">夜间模式</button><button data-action="settings">账号与备份</button><button data-action="trash">回收站</button><button data-action="logout">退出登录</button><a href="/">← 个人主页</a></div>
    </aside>
    <main data-workspace hidden><header class="row"><h1 id="heading">正在打开工作区…</h1><span id="save-status" role="status">正在读取</span></header><div id="cloud-banner"></div><div id="content"></div></main>
    <dialog id="dialog" data-workspace hidden><form id="form"><div class="row"><h2 id="dialog-title"></h2><button type="button" data-action="close">关闭</button></div><div id="fields"></div><p id="form-error" role="alert"></p><footer class="actions"><button id="submit" class="primary" type="submit">保存</button><button type="button" data-action="close">取消</button></footer></form></dialog>
    <div id="toast" data-workspace hidden role="status"></div><input id="backup-file" type="file" accept="application/json,.json" hidden /><input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
    <script>import '../workspace/bootstrap.js';</script>
  </body>
</html>
